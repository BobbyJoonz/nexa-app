{
  "expo": {
    "name": "NEXA Sunverter Academy",
    "slug": "nexa-sunverter-academy",
    "scheme": "nexaacademy",
    "version": "1.2.7",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexa.sunverteracademy",
      "buildNumber": "6",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fa",
        "CFBundleLocalizations": ["fa", "en"]
      }
    },
    "android": {
      "package": "com.nexa.sunverteracademy",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6F8"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F8",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 220
        }
      ],
      "./node_modules/@sentry/react-native/expo"
    ],
    "extra": {
      "sentry": {
        "dsn": ""
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
