{
  "expo": {
    "name": "NEXA Sunverter Academy",
    "slug": "nexa-sunverter-academy",
    "scheme": "nexaacademy",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexa.sunverteracademy",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fa",
        "CFBundleLocalizations": ["fa", "en"]
      }
    },
    "android": {
      "package": "com.nexa.sunverteracademy",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6F8"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
